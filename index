<script>
/* ==========================================================================
   CONEXIÓN CON EL BACKEND
   ========================================================================== */

let ocupado = 0;

function franja(texto, tono){
  const f = $("#franja");
  if (!texto){ f.hidden = true; return; }
  f.textContent = texto;
  f.className = "franja" + (tono === "trabajando" ? " trabajando" : "");
  f.hidden = false;
}

const API = {
  async llamar(accion, carga){
    if (!API_URL){
      throw new Error("Falta configurar API_URL arriba del archivo.");
    }

    ocupado++;
    if (ocupado === 1) franja("Guardando…", "trabajando");

    try{
      // text/plain evita el preflight que Apps Script no responde.
      const r = await fetch(API_URL, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        redirect: "follow",
        body: JSON.stringify(Object.assign({
          accion: accion,
          quien: QUIEN.etiqueta || "sin identificar",
          clave: CLAVE
        }, carga || {}))
      });

      if (!r.ok) throw new Error("El servidor respondió " + r.status);

      const j = await r.json();
      if (!j.ok) throw new Error(j.error || "Error del servidor");
      return j.datos;

    } finally {
      ocupado--;
      if (ocupado === 0) franja("");
    }
  }
};

/* ==========================================================================
   ESTADO
   ========================================================================== */

let datos = { areas: [], tareas: [] };
let vista = { tipo: "portada", area: null };
let QUIEN = { nombre: "", rol: "", etiqueta: "" };

const filtros = { estado: "abiertas", texto: "" };

const ESTADOS = {
  pendiente: "Pendiente",
  curso:     "En curso",
  trabada:   "Trabada",
  hecha:     "Hecha"
};

const CACHE_FOTOS = new Map();

/* ==========================================================================
   UTILIDADES
   ========================================================================== */

function $(s){ return document.querySelector(s); }

function escapar(t){
  return String(t ?? "").replace(/[&<>"']/g, c => (
    {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]
  ));
}

function hoyISO(){
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
}

function fechaLinda(iso){
  if(!iso) return "";
  const p = String(iso).split("-");
  return `${p[2]}/${p[1]}`;
}

function selloLindo(ms){
  const d = new Date(Number(ms) || ms);
  if (isNaN(d.getTime())) return "";
  const dd = String(d.getDate()).padStart(2,"0");
  const mm = String(d.getMonth()+1).padStart(2,"0");
  const hh = String(d.getHours()).padStart(2,"0");
  const mi = String(d.getMinutes()).padStart(2,"0");
  return `${dd}/${mm}/${d.getFullYear()} a las ${hh}:${mi}`;
}

function tareaAbierta(t){ return t.asignaciones.some(a => a.estado !== "hecha"); }
function tareaVencida(t){ return Boolean(t.vence) && tareaAbierta(t) && t.vence < hoyISO(); }
function tareaVenceHoy(t){ return Boolean(t.vence) && tareaAbierta(t) && t.vence === hoyISO(); }
function asigVencida(t,a){ return Boolean(t.vence) && a.estado !== "hecha" && t.vence < hoyISO(); }
function asigVenceHoy(t,a){ return Boolean(t.vence) && a.estado !== "hecha" && t.vence === hoyISO(); }

function deArea(area){
  return datos.tareas
    .map(t => ({ t, a: t.asignaciones.find(x => x.area === area) }))
    .filter(par => par.a);
}

let temporizadorCartel;
function avisar(texto){
  const c = $("#cartel");
  c.textContent = texto;
  c.hidden = false;
  clearTimeout(temporizadorCartel);
  temporizadorCartel = setTimeout(() => { c.hidden = true; }, 3400);
}

// Envoltorio: llama al backend, refresca y avisa si algo falla.
async function operar(accion, carga, mensajeOk){
  try{
    datos = await API.llamar(accion, carga);
    refrescar();
    if (mensajeOk) avisar(mensajeOk);
    return true;
  }catch(err){
    franja("No se pudo guardar: " + err.message + ". Revisá la conexión y probá de nuevo.");
    refrescar();
    return false;
  }
}

/* ==========================================================================
   IDENTIFICACIÓN
   ========================================================================== */

const CLAVE_QUIEN = "tareas20-quien";

function leerQuien(){
  try{
    const bruto = localStorage.getItem(CLAVE_QUIEN);
    return bruto ? JSON.parse(bruto) : null;
  }catch(e){ return null; }
}

function guardarQuien(q){
  try{ localStorage.setItem(CLAVE_QUIEN, JSON.stringify(q)); }catch(e){ /* modo privado */ }
}

function pintarSesion(){
  const s = $("#sesion");
  if (!QUIEN.nombre){ s.hidden = true; return; }
  s.hidden = false;
  s.innerHTML = `<span>Estás como <strong>${escapar(QUIEN.nombre)}</strong> · ${escapar(QUIEN.rol)}</span>
                 <button type="button" id="btnCambiarQuien">Cambiar</button>`;
  $("#btnCambiarQuien").onclick = () => pedirQuien();
}

function pedirQuien(){
  const roles = ["Gerencia"].concat(datos.areas);
  $("#opcionesRol").innerHTML = roles.map((r,i) => `
    <label class="opcion-quien">
      <input type="radio" name="rol" value="${escapar(r)}" ${(QUIEN.rol === r || (!QUIEN.rol && i===0)) ? "checked" : ""}>
      <span>${escapar(r)}</span>
    </label>`).join("");
  $("#qNombre").value = QUIEN.nombre || "";
  $("#errQuienNombre").hidden = true;
  $("#dlgQuien").showModal();
  $("#qNombre").focus();
}

$("#formQuien").addEventListener("submit", e => {
  e.preventDefault();
  const nombre = $("#qNombre").value.trim();
  $("#errQuienNombre").hidden = Boolean(nombre);
  if (!nombre){ $("#qNombre").focus(); return; }

  const rolElegido = document.querySelector('#opcionesRol input[name="rol"]:checked');
  const rol = rolElegido ? rolElegido.value : "Gerencia";

  QUIEN = { nombre, rol, etiqueta: `${nombre} (${rol})` };
  guardarQuien(QUIEN);
  pintarSesion();
  $("#dlgQuien").close();
});

/* ==========================================================================
   CABECERA
   ========================================================================== */

function pintarCabecera(){
  $("#institucion").textContent = INSTITUCION;
  $("#ranuraEscudo").innerHTML = ESCUDO
    ? `<img class="escudo" src="${escapar(ESCUDO)}" alt="Escudo del ${escapar(INSTITUCION)}">`
    : `<div class="escudo-vacio">Pegá el escudo en la constante ESCUDO</div>`;
}

function pintarResumen(){
  const abiertas = datos.tareas.filter(tareaAbierta).length;
  const paraHoy  = datos.tareas.filter(tareaVenceHoy).length;
  const vencidas = datos.tareas.filter(tareaVencida).length;
  const sinCerrar = datos.tareas
    .reduce((n,t) => n + t.asignaciones.filter(a => a.estado !== "hecha").length, 0);

  $("#resumen").innerHTML = `
    <div class="resumen-dato">
      <span class="resumen-valor">${abiertas}</span>
      <span class="resumen-rotulo">tareas abiertas</span>
    </div>
    <div class="resumen-dato">
      <span class="resumen-valor">${sinCerrar}</span>
      <span class="resumen-rotulo">sin cerrar por área</span>
    </div>
    <div class="resumen-dato">
      <span class="resumen-valor">${paraHoy}</span>
      <span class="resumen-rotulo">para hoy</span>
    </div>
    <div class="resumen-dato">
      <span class="resumen-valor ${vencidas ? "alerta" : ""}">${vencidas}</span>
      <span class="resumen-rotulo">vencidas</span>
    </div>`;
}

/* ==========================================================================
   PORTADA
   ========================================================================== */

function pintarPortada(){
  const rejilla = $("#rejilla");

  if (!datos.areas.length){
    rejilla.innerHTML = `
      <div class="vacio" style="grid-column:1/-1">
        <h2>Todavía no hay áreas</h2>
        <p>Agregá las áreas del club para empezar a repartir tareas.</p>
        <button class="boton boton-principal" data-abrir-areas>Editar áreas</button>
      </div>`;
    return;
  }

  rejilla.innerHTML = datos.areas.map(area => {
    const pares = deArea(area);
    const total = pares.length;
    const cerradas = pares.filter(p => p.a.estado === "hecha").length;
    const pendientes = total - cerradas;
    const vencidas = pares.filter(p => asigVencida(p.t,p.a)).length;

    if (!total){
      return `
        <button class="cuadro vacio-area" data-area="${escapar(area)}" disabled>
          <h3 class="cuadro-nombre">${escapar(area)}</h3>
          <p class="cuadro-sin">Sin tareas asignadas</p>
        </button>`;
    }

    const completo = pendientes === 0;
    const clases = ["cuadro"];
    if (completo) clases.push("completo");
    else if (vencidas) clases.push("con-vencidas");

    const cifra = completo
      ? `<div class="cuadro-cifra"><span class="cuadro-numero">${cerradas}</span><span class="cuadro-de">de ${total}</span></div>
         <p class="cuadro-rotulo">Todo cerrado</p>`
      : `<div class="cuadro-cifra"><span class="cuadro-numero">${pendientes}</span><span class="cuadro-de">de ${total}</span></div>
         <p class="cuadro-rotulo">Tareas pendientes</p>`;

    const alerta = vencidas ? `<p class="cuadro-alerta">${vencidas} vencida${vencidas===1?"":"s"}</p>` : "";
    const porcentaje = Math.round((cerradas/total)*100);

    return `
      <button class="${clases.join(" ")}" data-area="${escapar(area)}"
              aria-label="${escapar(area)}: ${pendientes} pendientes de ${total}">
        <h3 class="cuadro-nombre">${escapar(area)}</h3>
        ${cifra}
        ${alerta}
        <div class="cuadro-pie"><div class="barrita" role="presentation"><span style="width:${porcentaje}%"></span></div></div>
      </button>`;
  }).join("");
}

$("#rejilla").addEventListener("click", e => {
  if (e.target.closest("[data-abrir-areas]")){ pintarAreas(); $("#dlgAreas").showModal(); return; }
  const c = e.target.closest(".cuadro[data-area]");
  if (c && !c.disabled) abrirArea(c.dataset.area);
});

function abrirArea(area){
  vista = { tipo:"area", area };
  filtros.estado = "abiertas";
  filtros.texto = "";
  $("#busqueda").value = "";
  refrescar();
  window.scrollTo({ top:0 });
}

function volverAPortada(){
  vista = { tipo:"portada", area:null };
  refrescar();
}

$("#btnVolver").onclick = volverAPortada;
$("#btnVolverRegistro").onclick = volverAPortada;

/* ==========================================================================
   VISTA DE ÁREA
   ========================================================================== */

function pintarFiltros(){
  const caja = $("#filtroEstado");
  caja.querySelectorAll(".ficha").forEach(n => n.remove());
  const opciones = [
    ["abiertas","Abiertas"], ["pendiente","Pendientes"], ["curso","En curso"],
    ["trabada","Trabadas"], ["hecha","Hechas"], ["todas","Todas"]
  ];
  for(const [valor,texto] of opciones){
    const b = document.createElement("button");
    b.className = "ficha";
    b.type = "button";
    b.textContent = texto;
    b.setAttribute("aria-pressed", filtros.estado === valor);
    b.onclick = () => { filtros.estado = valor; pintarFiltros(); pintarListado(); };
    caja.appendChild(b);
  }
}

function pasaFiltro(t,a){
  if (filtros.estado === "abiertas" && a.estado === "hecha") return false;
  if (filtros.estado !== "abiertas" && filtros.estado !== "todas" && a.estado !== filtros.estado) return false;

  if (filtros.texto){
    const aguja = filtros.texto.toLowerCase();
    const pajar = [
      t.titulo, t.detalle, a.responsable,
      a.cierre ? a.cierre.por : "",
      a.cierre ? a.cierre.observaciones : ""
    ].join(" ").toLowerCase();
    if (!pajar.includes(aguja)) return false;
  }
  return true;
}

const ORDEN_PRIORIDAD = { alta:0, media:1, baja:2 };

function ordenarPares(x,y){
  const abX = x.a.estado !== "hecha";
  const abY = y.a.estado !== "hecha";
  if (abX !== abY) return abX ? -1 : 1;

  const vX = asigVencida(x.t,x.a);
  const vY = asigVencida(y.t,y.a);
  if (vX !== vY) return vX ? -1 : 1;

  const p = ORDEN_PRIORIDAD[x.t.prioridad] - ORDEN_PRIORIDAD[y.t.prioridad];
  if (p) return p;

  if (x.t.vence && y.t.vence && x.t.vence !== y.t.vence) return x.t.vence < y.t.vence ? -1 : 1;
  if (x.t.vence && !y.t.vence) return -1;
  if (!x.t.vence && y.t.vence) return 1;
  return y.t.creada - x.t.creada;
}

function pintarListado(){
  const area = vista.area;
  const pares = deArea(area);
  const cerradas = pares.filter(p => p.a.estado === "hecha").length;

  $("#areaTitulo").textContent = area;
  $("#areaCuenta").textContent = pares.length
    ? `${cerradas} de ${pares.length} cerradas`
    : "sin tareas asignadas";

  const cont = $("#listado");

  if (!pares.length){
    cont.innerHTML = `
      <div class="vacio">
        <h2>${escapar(area)} no tiene tareas</h2>
        <p>Cargá una tarea y elegí esta área para que aparezca acá.</p>
        <button class="boton boton-principal" data-nueva-aca>Cargar tarea para ${escapar(area)}</button>
      </div>`;
    return;
  }

  const visibles = pares.filter(p => pasaFiltro(p.t,p.a)).sort(ordenarPares);

  cont.innerHTML = visibles.length
    ? visibles.map(p => filaTarea(p.t,p.a,area)).join("")
    : `<div class="vacio"><h2>Ninguna tarea entra en este filtro</h2><p>Probá con otro estado o limpiá la búsqueda.</p></div>`;

  cargarFotosVisibles();
}

function filaTarea(t,a,area){
  const vencida = asigVencida(t,a);
  const hoy = asigVenceHoy(t,a);

  const meta = [];
  if (a.responsable) meta.push(`<span class="meta-responsable">${escapar(a.responsable)}</span>`);
  if (t.prioridad === "alta") meta.push(`<span class="prioridad-alta">Prioridad alta</span>`);
  if (t.vence){
    const clase = vencida ? "vencida" : (hoy ? "hoy" : "");
    const texto = vencida ? `Venció el ${fechaLinda(t.vence)}` : (hoy ? "Vence hoy" : `Para el ${fechaLinda(t.vence)}`);
    meta.push(`<span class="meta-vence ${clase}">${texto}</span>`);
  }

  if (t.asignaciones.length > 1){
    const total = t.asignaciones.length;
    const cerradas = t.asignaciones.filter(x => x.estado === "hecha").length;
    const otras = t.asignaciones.filter(x => x.area !== area).map(x => x.area).join(", ");
    meta.push(`<span class="compartida ${cerradas===total ? "completa" : ""}" title="También va a: ${escapar(otras)}">${cerradas} de ${total} áreas cerraron</span>`);
  }

  let cierre = "";
  if (a.cierre){
    const foto = a.cierre.fotoId
      ? `<img class="cierre-foto" alt="Foto del cierre" data-foto-id="${escapar(a.cierre.fotoId)}">`
      : "";
    const obs = a.cierre.observaciones ? `<p class="cierre-obs">${escapar(a.cierre.observaciones)}</p>` : "";
    cierre = `
      <div class="cierre">
        <div class="cierre-texto">
          <span class="cierre-firma">${escapar(a.cierre.por)}</span>
          <span class="cierre-cuando">— ${escapar(selloLindo(a.cierre.cuando))}</span>
          ${obs}
        </div>
        ${foto}
      </div>`;
  }

  const opciones = Object.keys(ESTADOS)
    .map(v => `<option value="${v}" ${a.estado===v?"selected":""}>${ESTADOS[v]}</option>`)
    .join("");

  return `
    <article class="tarea ${a.estado==="hecha"?"hecha":""}" data-estado="${a.estado}">
      <div class="marca"></div>
      <div class="tarea-cuerpo">
        <h3 class="tarea-titulo">${escapar(t.titulo)}</h3>
        ${t.detalle ? `<p class="tarea-detalle">${escapar(t.detalle)}</p>` : ""}
        ${meta.length ? `<div class="tarea-meta">${meta.join("")}</div>` : ""}
        ${cierre}
      </div>
      <div class="tarea-acciones">
        <select class="selector-estado" data-id="${t.id}" data-area="${escapar(area)}"
                aria-label="Estado de ${escapar(area)} para: ${escapar(t.titulo)}">${opciones}</select>
        <button class="icono" data-editar="${t.id}" aria-label="Editar: ${escapar(t.titulo)}">Editar</button>
        <button class="icono peligro" data-borrar="${t.id}" aria-label="Borrar: ${escapar(t.titulo)}">Borrar</button>
      </div>
    </article>`;
}

/* Fotos: se piden al backend de a una y se cachean en memoria. */
async function cargarFotosVisibles(){
  const nodos = [...document.querySelectorAll("img[data-foto-id]:not([src])")];
  for (const img of nodos){
    const idFoto = img.dataset.fotoId;
    if (CACHE_FOTOS.has(idFoto)){ img.src = CACHE_FOTOS.get(idFoto); continue; }
    try{
      const r = await API.llamar("foto", { id: idFoto });
      CACHE_FOTOS.set(idFoto, r.base64);
      img.src = r.base64;
    }catch(e){
      img.alt = "No se pudo cargar la foto";
    }
  }
}

$("#listado").addEventListener("change", e => {
  const sel = e.target.closest(".selector-estado");
  if (sel) pedirCambioEstado(sel.dataset.id, sel.dataset.area, sel.value);
});

$("#listado").addEventListener("click", e => {
  const foto = e.target.closest("img[data-foto-id]");
  if (foto && foto.src){ $("#fotoGrande").src = foto.src; $("#dlgFoto").showModal(); return; }
  if (e.target.closest("[data-nueva-aca]")) return abrirTarea(null, vista.area);
  const editar = e.target.closest("[data-editar]");
  if (editar) return abrirTarea(editar.dataset.editar);
  const borrar = e.target.closest("[data-borrar]");
  if (borrar) return borrarTarea(borrar.dataset.borrar);
});

$("#btnCerrarFoto").onclick = () => $("#dlgFoto").close();

