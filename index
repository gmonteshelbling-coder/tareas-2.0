<style>
:root{
  /* Color institucional. Si el rojo no es el exacto, cambiá solo esta línea. */
  --club: #C8102E;
  --club-suave: #FBEAED;

  --tinta: #191D21;
  --tinta-media: #565F68;
  --tinta-tenue: #8B959E;
  --fondo: #EDEFF1;
  --hoja: #FFFFFF;
  --linea: #DDE1E5;
  --linea-fuerte: #C4CBD1;

  --ok: #17703C;
  --ok-suave: #E7F2EB;
  --curso: #B26A00;
  --trabada: #9A2C2C;

  --radio: 3px;
}

*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}

body{
  margin:0;background:var(--fondo);color:var(--tinta);
  font-family:"Archivo","Helvetica Neue",Arial,sans-serif;
  font-size:15px;line-height:1.45;
}

button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--club);outline-offset:2px}
[hidden]{display:none !important}

.envoltorio{max-width:1080px;margin:0 auto;padding:0 20px 80px}

/* ---------- Franja de conexión ---------- */

.franja{
  padding:9px 20px;font-size:13.5px;text-align:center;
  background:var(--club);color:#fff;
}

.franja.trabajando{background:var(--tinta)}

/* ---------- Cabecera ---------- */

.cabecera{background:var(--hoja);border-bottom:3px solid var(--club);margin-bottom:22px}

.cabecera-interior{
  max-width:1080px;margin:0 auto;padding:20px;
  display:flex;align-items:center;gap:18px;flex-wrap:wrap;
}

.escudo{width:64px;height:64px;flex:none;object-fit:contain}

.escudo-vacio{
  width:64px;height:64px;flex:none;
  border:1px dashed var(--linea-fuerte);border-radius:var(--radio);
  display:flex;align-items:center;justify-content:center;text-align:center;
  font-family:"Archivo Narrow",Arial,sans-serif;
  font-size:10px;line-height:1.2;color:var(--tinta-tenue);padding:4px;
}

.identidad{flex:1 1 220px;min-width:0}

.institucion{
  font-family:"Archivo Narrow",Arial,sans-serif;
  font-weight:600;font-size:13px;letter-spacing:.04em;
  color:var(--tinta-media);margin:0 0 1px;
}

.titulo{margin:0;font-size:27px;font-weight:700;letter-spacing:-.02em;line-height:1.1}

.sesion{
  margin:5px 0 0;font-size:13px;color:var(--tinta-media);
  display:flex;align-items:center;gap:6px;flex-wrap:wrap;
}

.sesion strong{color:var(--tinta);font-weight:600}

.sesion button{
  border:none;background:none;color:var(--club);cursor:pointer;
  font-size:13px;padding:1px 3px;border-radius:var(--radio);
}

.sesion button:hover{background:var(--club-suave)}

.resumen{display:flex;gap:24px;flex:none;padding-left:22px;border-left:1px solid var(--linea)}

.resumen-dato{min-width:52px}

.resumen-valor{
  display:block;font-size:29px;font-weight:700;line-height:1;letter-spacing:-.02em;
  font-variant-numeric:tabular-nums;
}

.resumen-valor.alerta{color:var(--club)}

.resumen-rotulo{
  display:block;margin-top:4px;max-width:9ch;
  font-family:"Archivo Narrow",Arial,sans-serif;
  font-size:12px;line-height:1.25;color:var(--tinta-media);
}

/* ---------- Barra ---------- */

.barra{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:16px}

.boton{
  border:1px solid var(--linea-fuerte);background:var(--hoja);color:var(--tinta);
  border-radius:var(--radio);padding:8px 14px;cursor:pointer;font-weight:500;
}

.boton:hover{border-color:var(--tinta-tenue)}
.boton:disabled{opacity:.5;cursor:default}

.boton-principal{background:var(--club);border-color:var(--club);color:#fff;font-weight:600}
.boton-principal:hover{background:#A80C26;border-color:#A80C26}

.boton-tenue{border-color:transparent;background:transparent;color:var(--tinta-media);padding:8px 10px}
.boton-tenue:hover{color:var(--tinta);background:rgba(25,29,33,.05)}

.espaciador{flex:1}

/* ---------- Portada ---------- */

.rejilla{display:grid;grid-template-columns:repeat(auto-fill,minmax(228px,1fr));gap:14px}

.cuadro{
  display:flex;flex-direction:column;
  background:var(--hoja);border:1px solid var(--linea);
  border-top:4px solid var(--tinta-tenue);border-radius:var(--radio);
  padding:15px 16px 0;text-align:left;cursor:pointer;min-height:158px;
  font:inherit;color:inherit;
}

.cuadro:hover{border-color:var(--linea-fuerte);border-top-color:var(--tinta)}
.cuadro.completo{border-top-color:var(--ok)}
.cuadro.completo:hover{border-top-color:var(--ok)}
.cuadro.con-vencidas{border-top-color:var(--club)}
.cuadro.vacio-area{border-top-color:var(--linea-fuerte);cursor:default}
.cuadro.vacio-area:hover{border-color:var(--linea)}

.cuadro-nombre{
  font-family:"Archivo Narrow",Arial,sans-serif;
  font-weight:600;font-size:16px;line-height:1.2;margin:0 0 12px;
}

.cuadro-cifra{display:flex;align-items:baseline;gap:7px;font-variant-numeric:tabular-nums}
.cuadro-numero{font-size:38px;font-weight:700;line-height:.95;letter-spacing:-.03em}
.cuadro.completo .cuadro-numero{color:var(--ok)}
.cuadro.con-vencidas .cuadro-numero{color:var(--club)}
.cuadro-de{font-size:15px;color:var(--tinta-media)}

.cuadro-rotulo{
  font-family:"Archivo Narrow",Arial,sans-serif;
  font-size:13px;color:var(--tinta-media);margin:5px 0 0;
}

.cuadro-alerta{margin:7px 0 0;font-size:13px;font-weight:600;color:var(--club)}
.cuadro-pie{margin-top:auto;padding-top:14px}
.barrita{height:4px;background:var(--linea);border-radius:2px;overflow:hidden;margin:0 -16px}
.barrita span{display:block;height:100%;background:var(--ok)}
.cuadro-sin{color:var(--tinta-tenue);font-size:14px;margin:0}

/* ---------- Migas ---------- */

.migas{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px}

.volver{
  border:1px solid var(--linea-fuerte);background:var(--hoja);
  border-radius:var(--radio);padding:6px 12px;cursor:pointer;font-weight:500;
}

.volver:hover{border-color:var(--tinta-tenue)}

.migas h2{margin:0;font-family:"Archivo Narrow",Arial,sans-serif;font-weight:600;font-size:21px}
.migas .area-cuenta{font-size:14px}

/* ---------- Filtros ---------- */

.filtros{
  background:var(--hoja);border:1px solid var(--linea);border-radius:var(--radio);
  padding:12px 14px;margin-bottom:20px;
  display:flex;gap:20px;flex-wrap:wrap;align-items:center;
}

.filtro-grupo{display:flex;gap:6px;flex-wrap:wrap;align-items:center}

.filtro-titulo{
  font-family:"Archivo Narrow",Arial,sans-serif;
  font-size:12px;color:var(--tinta-media);margin-right:2px;
}

.ficha{
  border:1px solid var(--linea-fuerte);background:var(--hoja);
  border-radius:100px;padding:4px 11px;font-size:13px;cursor:pointer;white-space:nowrap;
}

.ficha:hover{border-color:var(--tinta-tenue)}
.ficha[aria-pressed="true"]{background:var(--tinta);border-color:var(--tinta);color:#fff}

.busqueda{
  flex:1 1 180px;min-width:140px;
  border:1px solid var(--linea-fuerte);border-radius:var(--radio);
  padding:7px 10px;background:var(--hoja);
}

.area-cuenta{font-size:13px;color:var(--tinta-media);font-variant-numeric:tabular-nums}

/* ---------- Tarea ---------- */

.tarea{
  background:var(--hoja);border:1px solid var(--linea);border-top:none;
  display:grid;grid-template-columns:6px 1fr auto;align-items:start;
}

.tarea:first-of-type{border-top:1px solid var(--linea)}
.tarea.hecha .tarea-titulo{color:var(--tinta-tenue);text-decoration:line-through}

.marca{width:6px;align-self:stretch;background:var(--linea-fuerte)}
.tarea[data-estado="pendiente"] .marca{background:var(--tinta-tenue)}
.tarea[data-estado="curso"] .marca{background:var(--curso)}
.tarea[data-estado="hecha"] .marca{background:var(--ok)}
.tarea[data-estado="trabada"] .marca{background:var(--trabada)}

.tarea-cuerpo{padding:12px 14px;min-width:0}
.tarea-titulo{font-weight:600;font-size:15.5px;margin:0 0 3px;overflow-wrap:anywhere}

.tarea-detalle{
  margin:0 0 7px;color:var(--tinta-media);font-size:14px;
  max-width:68ch;overflow-wrap:anywhere;
}

.tarea-meta{display:flex;gap:14px;flex-wrap:wrap;align-items:center;font-size:13px;color:var(--tinta-media)}

.meta-responsable{font-weight:500;color:var(--tinta)}
.meta-vence.vencida{color:var(--club);font-weight:600}
.meta-vence.hoy{color:var(--curso);font-weight:600}
.prioridad-alta{color:var(--club);font-weight:600}

.compartida{
  display:inline-flex;align-items:center;
  border:1px solid var(--linea-fuerte);border-radius:100px;
  padding:1px 9px;font-size:12.5px;color:var(--tinta-media);
}

.compartida.completa{border-color:var(--ok);color:var(--ok)}

.cierre{
  margin-top:10px;padding:10px 12px;
  background:var(--ok-suave);border-left:3px solid var(--ok);
  display:flex;gap:12px;align-items:flex-start;
}

.cierre-texto{flex:1;min-width:0;font-size:13.5px}
.cierre-firma{font-weight:600;color:var(--ok)}
.cierre-cuando{color:var(--tinta-media)}
.cierre-obs{margin:5px 0 0;color:var(--tinta);max-width:64ch;overflow-wrap:anywhere}

.cierre-foto{
  flex:none;width:64px;height:64px;object-fit:cover;
  border:1px solid var(--linea-fuerte);border-radius:var(--radio);
  cursor:zoom-in;display:block;background:var(--linea);
}

.tarea-acciones{
  padding:11px 12px;display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:flex-end;
}

.selector-estado{
  border:1px solid var(--linea-fuerte);border-radius:var(--radio);
  padding:5px 8px;background:var(--hoja);font-size:13px;cursor:pointer;
}

.icono{
  border:none;background:transparent;cursor:pointer;color:var(--tinta-tenue);
  padding:5px 7px;border-radius:var(--radio);font-size:13px;
}

.icono:hover{color:var(--tinta);background:rgba(25,29,33,.06)}
.icono.peligro:hover{color:var(--club);background:var(--club-suave)}

/* ---------- Registro ---------- */

.registro{background:var(--hoja);border:1px solid var(--linea);border-radius:var(--radio)}

.renglon{
  display:grid;grid-template-columns:150px 150px 1fr;gap:12px;
  padding:10px 14px;border-bottom:1px solid var(--linea);font-size:13.5px;
}

.renglon:last-child{border-bottom:none}
.renglon-cuando{color:var(--tinta-media);font-variant-numeric:tabular-nums}
.renglon-quien{font-weight:600}
.renglon-que{min-width:0;overflow-wrap:anywhere}
.renglon-donde{color:var(--tinta-media)}

/* ---------- Vacío ---------- */

.vacio{
  background:var(--hoja);border:1px solid var(--linea);border-radius:var(--radio);
  padding:44px 24px;text-align:center;
}

.vacio h2{margin:0 0 6px;font-size:18px;font-weight:600}
.vacio p{margin:0 auto 16px;color:var(--tinta-media);max-width:48ch}

/* ---------- Diálogos ---------- */

dialog{
  border:none;border-radius:var(--radio);padding:0;
  width:min(600px,calc(100vw - 32px));
  box-shadow:0 12px 40px rgba(25,29,33,.22);color:var(--tinta);
}

dialog::backdrop{background:rgba(25,29,33,.45)}

.dialogo-cabecera{padding:18px 22px 12px;border-bottom:1px solid var(--linea)}
.dialogo-cabecera h2{margin:0;font-size:19px;font-weight:600}
.dialogo-cabecera p{margin:4px 0 0;font-size:13.5px;color:var(--tinta-media)}

.dialogo-cuerpo{padding:18px 22px;max-height:66vh;overflow:auto}

.dialogo-pie{
  padding:14px 22px;border-top:1px solid var(--linea);
  display:flex;gap:10px;justify-content:flex-end;background:#F8F9FA;
}

.campo{margin-bottom:15px}
.campo:last-child{margin-bottom:0}

.campo > label{
  display:block;margin-bottom:5px;
  font-family:"Archivo Narrow",Arial,sans-serif;
  font-size:13px;color:var(--tinta-media);
}

.campo input[type="text"],.campo input[type="date"],.campo select,.campo textarea{
  width:100%;border:1px solid var(--linea-fuerte);border-radius:var(--radio);
  padding:8px 10px;background:var(--hoja);
}

.campo textarea{resize:vertical;min-height:70px}
.campo-fila{display:flex;gap:12px;flex-wrap:wrap}
.campo-fila .campo{flex:1 1 150px}
.error{color:var(--club);font-size:13px;margin-top:6px}
.pista{font-size:13px;color:var(--tinta-media);margin:6px 0 0}

.zona-foto{display:flex;gap:12px;align-items:center;flex-wrap:wrap}

.previa{
  width:92px;height:92px;object-fit:cover;
  border:1px solid var(--linea-fuerte);border-radius:var(--radio);display:block;
}

.selector-areas{border:1px solid var(--linea-fuerte);border-radius:var(--radio);overflow:hidden}

.selector-areas-barra{
  display:flex;gap:8px;align-items:center;
  padding:8px 11px;background:#F8F9FA;border-bottom:1px solid var(--linea);
  font-size:13px;color:var(--tinta-media);
}

.selector-areas-barra button{
  border:none;background:none;color:var(--club);cursor:pointer;
  font-size:13px;font-weight:500;padding:2px 4px;border-radius:var(--radio);
}

.selector-areas-barra button:hover{background:var(--club-suave)}

.fila-area{
  display:flex;align-items:center;gap:10px;
  padding:8px 11px;border-bottom:1px solid var(--linea);
}

.fila-area:last-child{border-bottom:none}
.fila-area.elegida{background:var(--club-suave)}

.fila-area label{
  display:flex;align-items:center;gap:8px;
  flex:1 1 150px;cursor:pointer;min-width:0;font-size:14.5px;
}

.fila-area input[type="checkbox"]{width:17px;height:17px;flex:none;accent-color:var(--club);cursor:pointer}

.fila-area .responsable{
  flex:1 1 130px;min-width:0;
  border:1px solid var(--linea-fuerte);border-radius:var(--radio);
  padding:5px 8px;font-size:13.5px;background:var(--hoja);
}

.lista-areas{list-style:none;margin:0 0 14px;padding:0}

.lista-areas li{
  display:flex;align-items:center;gap:8px;
  padding:7px 0;border-bottom:1px solid var(--linea);
}

.lista-areas li > span:first-child{flex:1}

.aviso{
  background:var(--club-suave);border-left:3px solid var(--club);
  padding:10px 13px;font-size:13.5px;margin-bottom:16px;
}

.opciones-quien{display:flex;flex-direction:column;gap:8px}

.opcion-quien{
  display:flex;align-items:center;gap:9px;
  border:1px solid var(--linea-fuerte);border-radius:var(--radio);
  padding:10px 12px;cursor:pointer;
}

.opcion-quien:hover{border-color:var(--tinta-tenue)}
.opcion-quien input{width:17px;height:17px;accent-color:var(--club)}

#dlgFoto{width:min(920px,calc(100vw - 32px));background:var(--tinta)}
#dlgFoto img{display:block;width:100%;height:auto;max-height:80vh;object-fit:contain}
#dlgFoto .dialogo-pie{background:var(--tinta);border-top-color:#333}

.cartel{
  position:fixed;left:50%;bottom:22px;transform:translateX(-50%);
  background:var(--tinta);color:#fff;padding:10px 18px;border-radius:100px;
  font-size:14px;box-shadow:0 6px 20px rgba(25,29,33,.3);z-index:50;
  max-width:calc(100vw - 40px);text-align:center;
}

/* ---------- Responsive ---------- */

@media (max-width:720px){
  .resumen{padding-left:0;border-left:none;width:100%;gap:20px}
  .titulo{font-size:23px}
  .resumen-valor{font-size:25px}
  .tarea{grid-template-columns:6px 1fr}
  .tarea-acciones{grid-column:2;padding:0 14px 12px;justify-content:flex-start}
  .rejilla{grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:11px}
  .cuadro{min-height:140px;padding:13px 13px 0}
  .cuadro-numero{font-size:32px}
  .barrita{margin:0 -13px}
  .renglon{grid-template-columns:1fr;gap:3px}
}

@media print{
  body{background:#fff;font-size:11pt}
  .barra,.filtros,.tarea-acciones,.cartel,.volver,.franja,.sesion{display:none !important}
  .cabecera{border-bottom:2px solid #000}
  .tarea,.cuadro,.cierre,.renglon{break-inside:avoid}
}

@media (prefers-reduced-motion:reduce){
  *{animation:none !important;transition:none !important}
}
</style>
</head>
<body>

<div class="franja" id="franja" hidden></div>

<header class="cabecera">
  <div class="cabecera-interior">
    <div id="ranuraEscudo"></div>
    <div class="identidad">
      <p class="institucion" id="institucion"></p>
      <h1 class="titulo">Tareas 2.0</h1>
      <p class="sesion" id="sesion" hidden></p>
    </div>
    <div class="resumen" id="resumen"></div>
  </div>
</header>

<div class="envoltorio">

  <div class="barra">
    <button class="boton boton-principal" id="btnNueva">Cargar tarea</button>
    <button class="boton" id="btnAreas">Editar áreas</button>
    <button class="boton" id="btnRegistro">Registro</button>
    <div class="espaciador"></div>
    <button class="boton boton-tenue" id="btnActualizar">Actualizar</button>
    <button class="boton boton-tenue" id="btnCopiar">Copiar para WhatsApp</button>
    <button class="boton boton-tenue" id="btnImprimir">Imprimir</button>
  </div>

  <section id="vistaPortada">
    <div class="rejilla" id="rejilla"></div>
  </section>

  <section id="vistaArea" hidden>
    <div class="migas">
      <button class="volver" id="btnVolver">← Áreas</button>
      <h2 id="areaTitulo"></h2>
      <span class="area-cuenta" id="areaCuenta"></span>
    </div>
    <div class="filtros">
      <div class="filtro-grupo" id="filtroEstado"><span class="filtro-titulo">Estado</span></div>
      <input type="search" class="busqueda" id="busqueda" placeholder="Buscar tarea o responsable" aria-label="Buscar tarea o responsable">
    </div>
    <div id="listado"></div>
  </section>

  <section id="vistaRegistro" hidden>
    <div class="migas">
      <button class="volver" id="btnVolverRegistro">← Áreas</button>
      <h2>Registro</h2>
      <span class="area-cuenta">todo lo que pasó, en orden</span>
    </div>
    <div class="registro" id="renglones"></div>
  </section>

</div>

<div class="cartel" id="cartel" hidden role="status"></div>

<!-- ¿Quién sos? -->
<dialog id="dlgQuien">
  <form id="formQuien">
    <div class="dialogo-cabecera">
      <h2>¿Quién sos?</h2>
      <p>Queda registrado en cada movimiento. Lo podés cambiar cuando quieras.</p>
    </div>
    <div class="dialogo-cuerpo">
      <div class="campo">
        <label for="qNombre">Tu nombre</label>
        <input type="text" id="qNombre" maxlength="60" autocomplete="name" placeholder="Nombre y apellido">
        <div class="error" id="errQuienNombre" hidden>Poné tu nombre.</div>
      </div>
      <div class="campo">
        <label id="rotuloRol">Desde dónde entrás</label>
        <div class="opciones-quien" id="opcionesRol" role="radiogroup" aria-labelledby="rotuloRol"></div>
      </div>
    </div>
    <div class="dialogo-pie">
      <button type="submit" class="boton boton-principal">Entrar</button>
    </div>
  </form>
</dialog>

<!-- Cargar / editar tarea -->
<dialog id="dlgTarea">
  <form id="formTarea">
    <div class="dialogo-cabecera"><h2 id="tituloDialogo">Cargar tarea</h2></div>
    <div class="dialogo-cuerpo">
      <div class="campo">
        <label for="fTitulo">Qué hay que hacer</label>
        <input type="text" id="fTitulo" maxlength="140" autocomplete="off">
        <div class="error" id="errTitulo" hidden>Poné al menos un título.</div>
      </div>
      <div class="campo">
