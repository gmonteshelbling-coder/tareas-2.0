   REFRESCO DE VISTAS
   ========================================================================== */

function refrescar(){
  pintarResumen();
  $("#vistaPortada").hidden  = vista.tipo !== "portada";
  $("#vistaArea").hidden     = vista.tipo !== "area";
  $("#vistaRegistro").hidden = vista.tipo !== "registro";

  if (vista.tipo === "portada"){
    pintarPortada();
  }else if (vista.tipo === "area"){
    if (!datos.areas.includes(vista.area)) return volverAPortada();
    pintarFiltros();
    pintarListado();
  }
}

/* ==========================================================================
   CIERRE DE TAREA
   ========================================================================== */

let cerrando = null;
let fotoCierre = "";

function comprimirImagen(archivo){
  return new Promise((resolver, rechazar) => {
    const lector = new FileReader();
    lector.onload = () => {
      const img = new Image();
      img.onload = () => {
        let w = img.naturalWidth, h = img.naturalHeight;
        const escala = Math.min(1, FOTO_LADO_MAX / Math.max(w,h));
        w = Math.round(w*escala); h = Math.round(h*escala);
        const lienzo = document.createElement("canvas");
        lienzo.width = w; lienzo.height = h;
        lienzo.getContext("2d").drawImage(img, 0, 0, w, h);
        resolver(lienzo.toDataURL("image/jpeg", FOTO_CALIDAD));
      };
      img.onerror = () => rechazar(new Error("No se pudo leer la imagen"));
      img.src = lector.result;
    };
    lector.onerror = () => rechazar(new Error("No se pudo abrir el archivo"));
    lector.readAsDataURL(archivo);
  });
}

$("#cFoto").addEventListener("change", async e => {
  const archivo = e.target.files[0];
  if (!archivo) return;
  try{
    fotoCierre = await comprimirImagen(archivo);
    const kb = Math.round(fotoCierre.length * 0.75 / 1024);
    $("#cPrevia").src = fotoCierre;
    $("#cPrevia").hidden = false;
    $("#btnQuitarFoto").hidden = false;
    $("#cPeso").textContent = `Se va a subir a Drive: unos ${kb} KB.`;
  }catch(err){
    avisar("No se pudo procesar esa imagen");
    limpiarFoto();
  }
});

function limpiarFoto(){
  fotoCierre = "";
  $("#cFoto").value = "";
  $("#cPrevia").hidden = true;
  $("#cPrevia").removeAttribute("src");
  $("#btnQuitarFoto").hidden = true;
  $("#cPeso").textContent = "Se sube a la carpeta del club en Drive.";
}

$("#btnQuitarFoto").onclick = limpiarFoto;

async function pedirCambioEstado(idTarea, area, estado){
  const t = datos.tareas.find(x => x.id === idTarea);
  if (!t) return;
  const a = t.asignaciones.find(x => x.area === area);
  if (!a) return;

  if (estado === "hecha" && !a.cierre){
    abrirCierre(idTarea, area, t, a);
    return;
  }

  if (a.estado === "hecha" && estado !== "hecha"){
    const ok = confirm(`Al reabrir esta tarea se saca la constancia de cierre de ${area}. Queda guardada en el registro, con la foto. ¿Seguimos?`);
    if (!ok){ refrescar(); return; }
    await operar("reabrirTarea", { tareaId: idTarea, area, estado }, "Tarea reabierta");
    return;
  }

  await operar("cambiarEstado", { tareaId: idTarea, area, estado });
}

function abrirCierre(idTarea, area, t, a){
  cerrando = { idTarea, area };
  limpiarFoto();
  $("#errQuien").hidden = true;
  $("#cQuien").value = a.responsable || QUIEN.nombre || "";
  $("#cObs").value = "";
  $("#cierreContexto").textContent = `${t.titulo} — ${area}`;
  $("#dlgCierre").showModal();
  $("#cQuien").focus();
}

$("#formCierre").addEventListener("submit", async e => {
  e.preventDefault();
  if (!cerrando) return;

  const por = $("#cQuien").value.trim();
  $("#errQuien").hidden = Boolean(por);
  if (!por){ $("#cQuien").focus(); return; }

  const boton = $("#btnGuardarCierre");
  boton.disabled = true;
  boton.textContent = fotoCierre ? "Subiendo la foto…" : "Guardando…";

  const ok = await operar("cerrarTarea", {
    tareaId: cerrando.idTarea,
    area: cerrando.area,
    por,
    observaciones: $("#cObs").value.trim(),
    fotoBase64: fotoCierre
  }, "Tarea cerrada");

  boton.disabled = false;
  boton.textContent = "Marcar como hecha";

  if (ok){
    cerrando = null;
    limpiarFoto();
    $("#dlgCierre").close();
  }
});

$("#btnCancelarCierre").onclick = () => {
  cerrando = null;
  limpiarFoto();
  $("#dlgCierre").close();
  refrescar();
};

$("#dlgCierre").addEventListener("cancel", () => {
  cerrando = null;
  limpiarFoto();
  setTimeout(refrescar, 0);
});

/* ==========================================================================
   FORMULARIO DE TAREA
   ========================================================================== */

let editando = null;

function pintarFilasAreas(preseleccion){
  const cont = $("#filasAreas");

  cont.innerHTML = datos.areas.map(area => {
    const previa = preseleccion.find(a => a.area === area);
    const elegida = Boolean(previa);
    return `
      <div class="fila-area ${elegida ? "elegida" : ""}" data-area="${escapar(area)}">
        <label>
          <input type="checkbox" ${elegida ? "checked" : ""}>
          <span>${escapar(area)}</span>
        </label>
        <input type="text" class="responsable" maxlength="60" autocomplete="off"
               placeholder="Responsable (opcional)"
               value="${escapar(previa ? previa.responsable : "")}" ${elegida ? "" : "hidden"}>
      </div>`;
  }).join("") || `<div class="fila-area"><span style="color:var(--tinta-tenue)">No hay áreas cargadas.</span></div>`;

  cont.querySelectorAll('input[type="checkbox"]').forEach(cb => {
    cb.addEventListener("change", () => {
      const fila = cb.closest(".fila-area");
      fila.classList.toggle("elegida", cb.checked);
      fila.querySelector(".responsable").hidden = !cb.checked;
      actualizarCuentaAreas();
    });
  });

  actualizarCuentaAreas();
}

function areasElegidas(){
  return [...document.querySelectorAll("#filasAreas .fila-area")]
    .filter(f => {
      const cb = f.querySelector('input[type="checkbox"]');
      return cb && cb.checked;
    })
    .map(f => ({ area: f.dataset.area, responsable: f.querySelector(".responsable").value.trim() }));
}

function actualizarCuentaAreas(){
  const n = areasElegidas().length;
  $("#cuentaElegidas").textContent =
    n === 0 ? "Ninguna área elegida" : n === 1 ? "1 área elegida" : `${n} áreas elegidas`;
}

function marcarTodas(valor){
  document.querySelectorAll("#filasAreas .fila-area").forEach(f => {
    const cb = f.querySelector('input[type="checkbox"]');
    if (!cb) return;
    cb.checked = valor;
    f.classList.toggle("elegida", valor);
    f.querySelector(".responsable").hidden = !valor;
  });
  actualizarCuentaAreas();
}

function abrirTarea(idTarea, areaSugerida){
  editando = idTarea || null;
  const t = idTarea ? datos.tareas.find(x => x.id === idTarea) : null;

  $("#tituloDialogo").textContent = t ? "Editar tarea" : "Cargar tarea";
  $("#btnGuardarTarea").textContent = t ? "Guardar cambios" : "Guardar tarea";
  $("#errTitulo").hidden = true;
  $("#errAreas").hidden = true;

  $("#fTitulo").value    = t ? t.titulo : "";
  $("#fDetalle").value   = t ? t.detalle : "";
  $("#fPrioridad").value = t ? t.prioridad : "media";
  $("#fVence").value     = t ? t.vence : "";

  let preseleccion = [];
  if (t) preseleccion = t.asignaciones;
  else if (areaSugerida) preseleccion = [{ area: areaSugerida, responsable: "" }];
  else if (vista.tipo === "area") preseleccion = [{ area: vista.area, responsable: "" }];

  pintarFilasAreas(preseleccion);
  $("#dlgTarea").showModal();
  $("#fTitulo").focus();
}

$("#formTarea").addEventListener("submit", async e => {
  e.preventDefault();

  const titulo = $("#fTitulo").value.trim();
  const elegidas = areasElegidas();

  $("#errTitulo").hidden = Boolean(titulo);
  $("#errAreas").hidden  = elegidas.length > 0;
  if (!titulo){ $("#fTitulo").focus(); return; }
  if (!elegidas.length) return;

  const carga = {
    titulo,
    detalle:   $("#fDetalle").value.trim(),
    prioridad: $("#fPrioridad").value,
    vence:     $("#fVence").value,
    asignaciones: elegidas
  };

  const boton = $("#btnGuardarTarea");
  boton.disabled = true;

  const ok = editando
    ? await operar("editarTarea", Object.assign({ id: editando }, carga), "Tarea actualizada")
    : await operar("crearTarea", carga,
        elegidas.length > 1 ? `Tarea cargada para ${elegidas.length} áreas` : "Tarea cargada");

  boton.disabled = false;
  if (ok) $("#dlgTarea").close();
});

async function borrarTarea(idTarea){
  const t = datos.tareas.find(x => x.id === idTarea);
  if (!t) return;
  const aviso = t.asignaciones.length > 1
    ? `"${t.titulo}" está asignada a ${t.asignaciones.length} áreas. Se saca de todas. Queda guardada en el registro. ¿Seguimos?`
    : `¿Borrar "${t.titulo}"? Queda guardada en el registro.`;
  if (!confirm(aviso)) return;
  await operar("borrarTarea", { id: idTarea }, "Tarea borrada");
}

/* ==========================================================================
   ÁREAS
   ========================================================================== */

function pintarAreas(){
  $("#listaAreas").innerHTML = datos.areas.map(a => {
    const n = deArea(a).length;
    return `
      <li>
        <span>${escapar(a)}</span>
        <span class="area-cuenta">${n} tarea${n===1?"":"s"}</span>
        <button class="icono peligro" type="button" data-quitar="${escapar(a)}" aria-label="Dar de baja ${escapar(a)}">Dar de baja</button>
      </li>`;
  }).join("") || `<li><span style="color:var(--tinta-tenue)">No hay áreas cargadas.</span></li>`;
}

$("#listaAreas").addEventListener("click", async e => {
  const b = e.target.closest("[data-quitar]");
  if (!b) return;
  const nombre = b.dataset.quitar;
  const n = deArea(nombre).length;
  const texto = n
    ? `"${nombre}" tiene ${n} tarea(s). Se saca de la app pero no se borra nada: queda todo en la planilla. ¿Seguimos?`
    : `¿Dar de baja el área "${nombre}"?`;
  if (!confirm(texto)) return;
  await operar("quitarArea", { nombre }, "Área dada de baja");
  pintarAreas();
});

$("#btnAgregarArea").onclick = async () => {
  const campo = $("#fNuevaArea");
  const nombre = campo.value.trim();
  if (!nombre) return;
  if (datos.areas.some(a => a.toLowerCase() === nombre.toLowerCase())){
    avisar("Esa área ya existe");
    return;
  }
  const ok = await operar("agregarArea", { nombre }, "Área agregada");
  if (ok){ campo.value = ""; campo.focus(); pintarAreas(); }
};

/* ==========================================================================
   COMPARTIR
   ========================================================================== */

function textoParaCompartir(){
  let salida = `*Tareas 2.0 — ${INSTITUCION}*\n${fechaLinda(hoyISO())}\n`;
  let hubo = false;

  const areas = vista.tipo === "area" ? [vista.area] : datos.areas;

  for (const area of areas){
    const filas = deArea(area).filter(p => p.a.estado !== "hecha").sort(ordenarPares);
    if (!filas.length) continue;
    hubo = true;
    salida += `\n*${area}*\n`;
    for (const { t, a } of filas){
      const partes = [];
      if (a.responsable) partes.push(a.responsable);
      if (t.vence) partes.push(asigVencida(t,a) ? `vencida ${fechaLinda(t.vence)}` : `para ${fechaLinda(t.vence)}`);
      if (a.estado === "curso") partes.push("en curso");
      if (a.estado === "trabada") partes.push("trabada");
      if (t.prioridad === "alta") partes.push("prioridad alta");
      salida += `• ${t.titulo}${partes.length ? ` (${partes.join(", ")})` : ""}\n`;
    }
  }
  return hubo ? salida : "No hay tareas sin cerrar.";
}

async function copiar(){
  const texto = textoParaCompartir();
  try{
    await navigator.clipboard.writeText(texto);
    avisar("Copiado. Pegalo en el grupo.");
  }catch(e){
    const ta = document.createElement("textarea");
    ta.value = texto;
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    try{ document.execCommand("copy"); avisar("Copiado. Pegalo en el grupo."); }
    catch(err){ avisar("No se pudo copiar desde este navegador"); }
    ta.remove();
  }
}

